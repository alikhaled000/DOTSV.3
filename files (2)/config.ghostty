#
# Ghostty Configuration (ML4W + kitty converted)

# Font
font-family = "FiraCode Nerd Font"
font-style = "SemiBold"
font-size = 16
adjust-cell-height = 40%

# Window
window-width = 950
window-height = 500
window-padding-x = 10
window-padding-y = 10
window-decoration = false

# Cursor
cursor-style-blink = true

# Scrollback
scrollback-limit = 2000

# Mouse
mouse-scroll-multiplier = 1

# Audio
bell-features = no-sound

# Opacity
background-opacity = 0.7

# Colors (auto updated by matugen on wallpaper change)
config-file = ~/.config/ghostty/colors-matugen.conf
